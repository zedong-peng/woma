{
  "name": "@x19-507/woma",
  "version": "1.0.0",
  "description": "Conda for AI coding agents: give your Claude Code and Codex named, isolated sets of Skills, plugins and MCP servers, and recreate the whole harness from one file.",
  "type": "module",
  "bin": {
    "woma": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "examples",
    "scripts/postinstall.mjs",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:live": "npm run build --silent && WOMA_LIVE_TESTS=1 node --test dist/test/live.test.js",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "harness",
    "skills",
    "agent-skills",
    "mcp",
    "claude-code",
    "codex",
    "conda",
    "environment",
    "package-manager",
    "reproducibility",
    "plugins"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zedong-peng/woma.git"
  },
  "homepage": "https://github.com/zedong-peng/woma#readme",
  "bugs": {
    "url": "https://github.com/zedong-peng/woma/issues"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.8.0"
  }
}
