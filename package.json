{
  "name": "woma",
  "version": "0.7.0",
  "description": "Reproducible environments and packages for coding agents.",
  "type": "module",
  "bin": {
    "woma": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "examples/performance-engineering",
    "examples/reproducibility-core",
    "examples/paper-search",
    "examples/idea-gen",
    "examples/exp-design",
    "examples/auto-research",
    "examples/woma-package-builder",
    "examples/native-codex-review",
    "examples/native-claude-review",
    "scripts/postinstall.mjs",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:live": "npm run build --silent && WOMA_LIVE_TESTS=1 node --test dist/test/live.test.js",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node dist/src/cli.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "keywords": [
    "agent",
    "skills",
    "mcp",
    "codex",
    "claude-code",
    "woma",
    "environment",
    "package-manager",
    "reproducibility"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zedong-peng/woma.git"
  },
  "homepage": "https://github.com/zedong-peng/woma#readme",
  "bugs": {
    "url": "https://github.com/zedong-peng/woma/issues"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "jsonc-parser": "^3.3.1",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "toml-eslint-parser": "^1.0.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.8.0"
  }
}
